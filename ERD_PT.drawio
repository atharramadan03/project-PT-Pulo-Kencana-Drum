  <diagram name="Page-1" id="RdI9lljKfWPtONLw9Fj7">
    <mxGraphModel dx="4339" dy="1961" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% ========================================================\n    %% CHEN NOTATION TEMPLATE STYLING (PURPLE + SKY BLUE + LAVENDER)\n    %% Sesuai update validasi PT Pulo Kencana Drum Industri\n    %% ========================================================\n    classDef banner fill:#9c27b0,stroke:#7b1fa2,stroke-width:2px,color:#ffffff,font-size:16px,font-weight:bold;\n    classDef entity fill:#ab47bc,stroke:#6a1b9a,stroke-width:2.5px,color:#ffffff,font-weight:bold,font-size:13px;\n    classDef weakEntity fill:#ab47bc,stroke:#4a148c,stroke-width:4px,color:#ffffff,font-weight:bold,font-size:13px;\n    classDef rel fill:#90caf9,stroke:#1976d2,stroke-width:2px,color:#0d47a1,font-weight:bold,font-size:12px;\n    classDef attr fill:#ffffff,stroke:#424242,stroke-width:1.5px,color:#212121,font-size:11px;\n    classDef relAttr fill:#e1bee7,stroke:#8e24aa,stroke-width:1.5px,color:#4a148c,font-size:11px;\n\n    %% 0. TOP BANNER\n    BANNER[\&quot;Chen Notation Entity Relationship Diagram — PT Pulo Kencana Drum Industri (Updated)\&quot;]:::banner\n\n    BANNER ~~~ A_A_EMAIL\n    BANNER ~~~ A_S_USER\n\n    %% ========================================================\n    %% TOP LEVEL: ADMIN KANTOR (Kiri Atas) &amp; SATPAM (Kanan Atas)\n    %% ========================================================\n    \n    %% Atribut Admin Kantor\n    A_A_ID([\&quot;AdminID (PK)\&quot;]):::attr\n    A_A_NAMA([\&quot;NamaAdmin\&quot;]):::attr\n    A_A_EMAIL([\&quot;Email\&quot;]):::attr\n    A_A_ROLE([\&quot;HakAkses\&quot;]):::attr\n\n    A_A_ID --- E_ADMIN\n    A_A_NAMA --- E_ADMIN\n    A_A_EMAIL --- E_ADMIN\n    A_A_ROLE --- E_ADMIN\n\n    E_ADMIN[\&quot;Admin Kantor (User)\&quot;]:::entity\n\n    %% Atribut Satpam\n    A_S_ID([\&quot;UserID (PK)\&quot;]):::attr\n    A_S_NAMA([\&quot;NamaSatpam\&quot;]):::attr\n    A_S_USER([\&quot;Username\&quot;]):::attr\n    A_S_SHIFT([\&quot;ShiftJaga\&quot;]):::attr\n\n    A_S_ID --- E_SATPAM\n    A_S_NAMA --- E_SATPAM\n    A_S_USER --- E_SATPAM\n    A_S_SHIFT --- E_SATPAM\n\n    E_SATPAM[\&quot;Satpam (User)\&quot;]:::entity\n\n    %% ========================================================\n    %% RELASI DARI ATAS KE TENGAH\n    %% ========================================================\n    \n    %% Kiri: Admin Kantor -&gt; Menginput -&gt; Drum Batches\n    R_INPUT{\&quot;Menginput\&quot;}:::rel\n    E_ADMIN ---|\&quot;1\&quot;| R_INPUT\n    R_INPUT ---|\&quot;N\&quot;| E_BATCH\n\n    %% Kanan: Satpam -&gt; Mencatat &amp; Memeriksa -&gt; Vehicle Visits\n    R_MENCATAT{\&quot;Mencatat\&quot;}:::rel\n    E_SATPAM ---|\&quot;1\&quot;| R_MENCATAT\n    R_MENCATAT ---|\&quot;N\&quot;| E_VISIT\n\n    %% Atribut Relasi pada Mencatat (Termasuk Verifikasi Surat Jalan Limbah B3)\n    RA_WKT([\&quot;WaktuCatat\&quot;]):::relAttr\n    RA_VERIFB3([\&quot;PeriksaSuratJalanB3\&quot;]):::relAttr\n    R_MENCATAT --- RA_WKT\n    R_MENCATAT --- RA_VERIFB3\n\n    %% ========================================================\n    %% MIDDLE LEVEL: DRUM BATCHES (Kiri) &amp; VEHICLE VISITS (Kanan)\n    %% ========================================================\n    \n    E_BATCH[\&quot;Drum Batches\&quot;]:::entity\n\n    %% Atribut Drum Batches\n    A_B_ID([\&quot;BatchID (PK)\&quot;]):::attr\n    A_B_KODE([\&quot;KodeBatch\&quot;]):::attr\n    A_B_TGL([\&quot;TanggalPenerimaan\&quot;]):::attr\n    A_B_QTY([\&quot;JumlahDiterima\&quot;]):::attr\n    A_B_ENDAP([\&quot;StatusPengendapan\&quot;]):::attr\n    A_B_PROS([\&quot;StatusProses\&quot;]):::attr\n\n    E_BATCH --- A_B_ID\n    E_BATCH --- A_B_KODE\n    E_BATCH --- A_B_TGL\n    E_BATCH --- A_B_QTY\n    E_BATCH --- A_B_ENDAP\n    E_BATCH --- A_B_PROS\n\n    E_VISIT[\&quot;Vehicle Visits\&quot;]:::entity\n\n    %% Atribut Vehicle Visits (Diperbarui dengan Dokumen Kemasan Limbah B3)\n    A_V_ID([\&quot;VisitID (PK)\&quot;]):::attr\n    A_V_NO([\&quot;NomorKunjungan\&quot;]):::attr\n    A_V_POL([\&quot;NomorPolisi\&quot;]):::attr\n    A_V_SUPIR([\&quot;NamaPengemudi\&quot;]):::attr\n    A_V_ASAL([\&quot;AsalTujuan\&quot;]):::attr\n    A_V_WIN([\&quot;WaktuMasuk\&quot;]):::attr\n    A_V_WOUT([\&quot;WaktuKeluar\&quot;]):::attr\n    A_V_B3([\&quot;SuratJalanLimbahB3\&quot;]):::attr\n\n    A_V_ID --- E_VISIT\n    A_V_NO --- E_VISIT\n    A_V_POL --- E_VISIT\n    A_V_SUPIR --- E_VISIT\n    A_V_ASAL --- E_VISIT\n    A_V_WIN --- E_VISIT\n    A_V_WOUT --- E_VISIT\n    A_V_B3 --- E_VISIT\n\n    %% ========================================================\n    %% RELASI HORIZONTAL TENGAH: MENGANGKUT (Center Diamond)\n    %% ========================================================\n    R_ANGKUT{\&quot;Mengangkut\&quot;}:::rel\n    E_VISIT ---|\&quot;M\&quot;| R_ANGKUT\n    R_ANGKUT ---|\&quot;N\&quot;| E_BATCH\n\n    %% Atribut Relasi pada Mengangkut (Oval Lavender di bawah diamond)\n    RA_JML([\&quot;JumlahDrum\&quot;]):::relAttr\n    RA_MUAT([\&quot;KeteranganMuatan\&quot;]):::relAttr\n    R_ANGKUT --- RA_JML\n    R_ANGKUT --- RA_MUAT\n\n    %% ========================================================\n    %% BOTTOM LEVEL: DRUM PROCESS LOGS (Weak / Dependent Entity)\n    %% ========================================================\n    \n    %% Relasi Menjalani dari Drum Batches\n    R_JALAN{\&quot;Menjalani\&quot;}:::rel\n    E_BATCH ---|\&quot;1\&quot;| R_JALAN\n    R_JALAN ---|\&quot;N\&quot;| E_LOG\n\n    %% Relasi Merekam dari Admin Kantor\n    R_REKAM{\&quot;Merekam\&quot;}:::rel\n    E_ADMIN ---|\&quot;1\&quot;| R_REKAM\n    R_REKAM ---|\&quot;N\&quot;| E_LOG\n\n    E_LOG[\&quot;Drum Process Logs\&quot;]:::weakEntity\n\n    %% Atribut Process Logs (Cabang ke bawah)\n    A_L_ID([\&quot;LogID (PK)\&quot;]):::attr\n    A_L_JNS([\&quot;JenisProses\&quot;]):::attr\n    A_L_AKT([\&quot;TanggalAktivitas\&quot;]):::attr\n    A_L_INP([\&quot;TanggalInput\&quot;]):::attr\n    A_L_QTY([\&quot;JumlahDiproses\&quot;]):::attr\n    A_L_REJ([\&quot;JumlahAfkir\&quot;]):::attr\n    A_L_PEL([\&quot;PelaporGudang\&quot;]):::attr\n\n    E_LOG --- A_L_ID\n    E_LOG --- A_L_JNS\n    E_LOG --- A_L_AKT\n    E_LOG --- A_L_INP\n    E_LOG --- A_L_QTY\n    E_LOG --- A_L_REJ\n    E_LOG --- A_L_PEL\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="DwTtDcb0abQd7kOkl7lz-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
